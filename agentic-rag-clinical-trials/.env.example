# llm keys - whichever provider you set AGENT_MODEL to
GROQ_API_KEY=
GOOGLE_API_KEY=
OLLAMA_API_KEY=
AGENT_MODEL=groq:openai/gpt-oss-120b

# AACT public db (free account at aact.ctti-clinicaltrials.org)
AACT_DB_HOST=aact-db.ctti-clinicaltrials.org
AACT_DB_PORT=5432
AACT_DB_NAME=aact
AACT_DB_USER=
AACT_DB_PASSWORD=

# optional - langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
